# Camea — what git ignores.
#
# The tree you work in IS the repo you publish. There is no allowlist any more:
# if a file is here and not matched below, it ships. That is deliberate — the old
# deny-all + allowlist scheme once staged 139 MB including the ground truth,
# because a pattern with a trailing comment silently matched nothing.

# --- big things that are not code -------------------------------------------
# the read-only rclone mirror of the Drive folder (~35 GB). never written to.
/data/

# finished research, kept for reference: the placement challenge, the old app,
# the hand-authored ground truth, the notebooks. ~32 GB. gitignored, not deleted.
/archive/

# Claude's infrastructure: the cross-session knowledge base, vendored refs, rclone.
/utils/

# plain-language explainers (big inlined-figure HTML) and rendered PNGs
/learn/
/output/

# --- environments and builds ------------------------------------------------
.venv/
node_modules/
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]

# --- generated / local ------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
playwright-report/
test-results/
.playwright-mcp/

# --- data-shaped outputs, wherever they land --------------------------------
*.npz
*.npy
*.tif
*.tiff
*.camea.json

# ...except the committed synthetic test fixtures. These are TINY (~1 MB), fake,
# and they are the only reason CI can run without the 35 GB mirror. They ship.
!/tests/fixtures/**
# (the re-include above would otherwise resurrect pycache under fixtures)
/tests/fixtures/**/__pycache__/

# --- editor / OS ------------------------------------------------------------
.vscode/
.claude/
Thumbs.db
.DS_Store

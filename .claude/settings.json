{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "camea",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run python*)",
      "Bash(uv sync*)",
      "Bash(uv --version)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm list*)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(node -e *)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git remote -v*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git for-each-ref*)",
      "Bash(git ls-files*)",
      "Bash(git blame*)",
      "Bash(git shortlog*)",
      "Bash(git config --get*)",
      "Bash(git stash list*)",
      "Bash(git worktree list*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(curl -s*)",
      "Bash(curl -sI*)",
      "Bash(date*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(rm -rf /*)",
      "PowerShell(sudo *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(gh pr create*)",
      "Bash(git worktree remove*)",
      "Bash(uv run pytest tests/slow*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/utils/knowledge/_session_start.js\"",
            "timeout": 10,
            "statusMessage": "Loading Camea knowledge base"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-write-guard.js"
          }
        ]
      },
      {
        "matcher": "take_screenshot|browser_take_screenshot",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/screenshot-guard.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-gates.js"
          }
        ]
      }
    ]
  }
}
